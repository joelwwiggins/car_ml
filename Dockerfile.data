# Dockerfile for OBD2 Data Collector with GMM Anomaly Detection
# Optimized for Raspberry Pi Zero 2W (ARMv7, 512MB RAM)

FROM arm32v7/python:3.11-slim-bookworm

# Install system dependencies for CAN bus and minimal requirements
RUN apt-get update && apt-get install -y \
    can-utils \
    iproute2 \
    net-tools \
    python3-dev \
    build-essential \
    libatlas-base-dev \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Create directories for logs and config
RUN mkdir -p /app/logs /app/config

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY obd2_collector.py .

# Copy configuration
COPY obd2_config.json /app/config/

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash app && chown -R app:app /app
USER app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import requests; requests.get('http://localhost:8000')" || exit 1

# Expose Prometheus metrics port
EXPOSE 8000

# Default command
CMD ["python3", "obd2_collector.py"]